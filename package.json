{
  "name": "ferrule",
  "version": "0.8.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "Wiring and plumbing diagrams from YAML",
  "type": "module",
  "bin": {
    "ferrule": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "spike": "node spike/run.ts",
    "parity": "node parity/run.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "elkjs": "0.12.0",
    "fontverter": "2.0.0",
    "harfbuzzjs": "1.6.2",
    "inter-ui": "4.1.1",
    "subset-font": "2.9.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
